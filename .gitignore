# macOS
.DS_Store

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code: agents' worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# Playwright's page snapshots and screenshots, written into whatever folder the CLI or MCP server runs from
.playwright-cli/
.playwright-mcp/

# Each worktree's local copy of the issue it's building (see Parallel Workflow in CLAUDE.md)
/ISSUE.md

# Local env overrides (committed defaults live in ui/.env.development)
.env.local
.env.*.local
